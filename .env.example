# ---- مطلوب ----
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
# رقمك الخاص: ابعت /start لـ @NafPTbot وهيقولك الرقم (مش رقم البوت)
TELEGRAM_CHAT_ID=

# ---- هوية البوت (متغيّرهاش) ----
EXPECTED_BOT_USERNAME=NafPTbot

# ---- Gemini ----
GEMINI_MODEL=gemini-3.5-flash
GEMINI_DAILY_LIMIT=250

# ---- الموقع (اتأكد بـ python check_site.py) ----
NAFEZLY_LIST_URL=https://nafezly.com/projects
NAFEZLY_LINK_REGEX=href=["']([^"']*?/project/[^"']+)["']
NAFEZLY_DETAIL_SELECTOR=main
MAX_PAGES=3
REQUEST_DELAY=1.5

# ---- الدرجات ----
MIN_SCORE=4
STRONG_SCORE=7
EXCELLENT_SCORE=9
ENABLE_WORDPRESS=0
ENABLE_MOBILE=0

# ---- المراقبة (الفواصل بالثواني) ----
POLL_ACTIVE=90
POLL_QUIET=300
ACTIVE_FROM=10
ACTIVE_TO=24
MAX_PROCESS_PER_TICK=3
MAX_NOTIFY_PER_TICK=3
